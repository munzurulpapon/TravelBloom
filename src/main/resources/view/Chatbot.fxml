<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../style/style.css, @../style/dark-theme.css, @../style/dark-theme-2.css"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.travelbloom.controller.ChatBotController">

    <StackPane style="-fx-background-color: #0a1826;">
        <ImageView fx:id="backgroundImage" preserveRatio="false"/>
        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(6,16,26,0.80), rgba(6,16,26,0.92));"/>
    </StackPane>

    <VBox spacing="12">

        <padding>
            <Insets top="25" right="30" bottom="25" left="30"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">

            <Button text="← Back to Smart Planner" onAction="#handleBack" styleClass="dark-secondary-button"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🔄 Restart" onAction="#handleRestart" styleClass="dark-secondary-button"/>

        </HBox>

        <Label text="🤖 Trip Planning Assistant" styleClass="dark-page-header-title"/>
        <Label text="Tell me where you want to go — I'll build a real itinerary with live weather and local highlights."
               styleClass="dark-subtitle"/>

        <VBox spacing="0" styleClass="dark-glass-card" VBox.vgrow="ALWAYS" style="-fx-padding: 0;">

            <ScrollPane fx:id="chatScrollPane"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 20;">

                <content>
                    <VBox fx:id="chatContainer" spacing="14"/>
                </content>

            </ScrollPane>

            <!-- FREE-TEXT INPUT ROW -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 14; -fx-border-color: rgba(255,255,255,0.08) transparent transparent transparent; -fx-border-width: 1;">

                <TextField fx:id="chatInputField" promptText="Type your answer..." styleClass="dark-input" HBox.hgrow="ALWAYS" onAction="#handleSendText"/>
                <Button text="Send" onAction="#handleSendText" styleClass="dark-primary-button"/>

            </HBox>

        </VBox>

    </VBox>

</StackPane>
