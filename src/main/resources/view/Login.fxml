<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane stylesheets="@../style/style.css"
           styleClass="auth-page"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.travelbloom.controller.LoginController">

    <!-- Decorative gradient background -->
    <Region styleClass="auth-background"/>

    <!-- Floating decorative blobs for a soft "travel" feel -->
    <Region styleClass="auth-blob-1" StackPane.alignment="TOP_LEFT"/>
    <Region styleClass="auth-blob-2" StackPane.alignment="BOTTOM_RIGHT"/>

    <!-- Login card -->
    <VBox styleClass="auth-card"
          maxWidth="400"
          maxHeight="520"
          spacing="18"
          alignment="CENTER">

        <Label text="🌸" style="-fx-font-size: 42px;"/>

        <Label text="TravelBloom" styleClass="auth-title"/>

        <Label text="Plan your journey, beautifully."
               styleClass="auth-subtitle"/>

        <VBox spacing="14" style="-fx-padding: 10 0 0 0;">

            <VBox spacing="6">
                <Label text="Username" styleClass="auth-field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           styleClass="auth-input"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="auth-field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="auth-input"/>
            </VBox>

            <Label fx:id="errorLabel"
                   styleClass="auth-error"
                   wrapText="true"/>

            <Button fx:id="loginButton"
                    text="Log In"
                    onAction="#handleLogin"
                    styleClass="auth-primary-button"
                    maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="New to TravelBloom?" styleClass="auth-footer-text"/>
                <Hyperlink fx:id="signupLink"
                           text="Create an account"
                           onAction="#handleGoToSignup"/>
            </HBox>

        </VBox>

    </VBox>

</StackPane>
