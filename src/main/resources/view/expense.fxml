<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../style/style.css, @../style/dark-theme.css, @../style/dark-theme-2.css"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.travelbloom.controller.ExpenseController">

    <StackPane style="-fx-background-color: #0a1826;">
        <ImageView fx:id="backgroundImage" preserveRatio="false"/>
        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(6,16,26,0.75), rgba(6,16,26,0.92));"/>
    </StackPane>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

        <content>

            <VBox spacing="22">

                <padding>
                    <Insets top="30" right="45" bottom="40" left="45"/>
                </padding>

                <HBox alignment="CENTER_LEFT" styleClass="dark-page-header">
                    <Button text="← Back" onAction="#handleBack" styleClass="dark-secondary-button"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="💰 Expenses" styleClass="dark-page-header-title"/>
                    <Label text="Track spending against your trip budget" styleClass="dark-subtitle"/>
                </VBox>


                <!-- BUDGET SUMMARY -->
                <HBox spacing="18">

                    <VBox spacing="6" styleClass="stat-card-teal" HBox.hgrow="ALWAYS">
                        <Label text="Trip Budget" styleClass="stat-label"/>
                        <Label fx:id="budgetLabel" text="৳ 0.00" styleClass="stat-value"/>
                    </VBox>

                    <VBox spacing="6" styleClass="stat-card-purple" HBox.hgrow="ALWAYS">
                        <Label text="Total Spent" styleClass="stat-label"/>
                        <Label fx:id="totalSpentLabel" text="৳ 0.00" styleClass="stat-value"/>
                    </VBox>

                    <VBox spacing="6" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                        <Label text="Remaining" styleClass="stat-label"/>
                        <Label fx:id="remainingLabel" text="৳ 0.00" styleClass="stat-value"/>
                    </VBox>

                </HBox>


                <!-- INPUT FORM -->
                <VBox spacing="15" styleClass="dark-glass-card">

                    <Label text="Add Expense" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <GridPane hgap="15" vgap="12">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>

                        <Label text="Category:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="categoryComboBox" promptText="Select category" maxWidth="Infinity" styleClass="dark-combo-box"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Date:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <DatePicker fx:id="datePicker" maxWidth="Infinity" styleClass="dark-date-picker" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Description:" styleClass="dark-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="descriptionField" promptText="e.g. Dinner at seaside restaurant" maxWidth="Infinity" styleClass="dark-input"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Amount (৳):" styleClass="dark-form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="3">
                            <TextField fx:id="amountField" promptText="e.g. 1500" styleClass="dark-input" HBox.hgrow="ALWAYS"/>
                            <Button text="💡 Suggest" onAction="#handleSuggestPrice" styleClass="dark-secondary-button"/>
                        </HBox>

                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <Button text="➕ Add Expense" onAction="#handleAddExpense" styleClass="dark-primary-button"/>
                        <Button text="✏ Update Selected" onAction="#handleUpdateExpense" styleClass="dark-secondary-button"/>
                        <Button text="🗑 Delete Selected" onAction="#handleDeleteExpense" styleClass="dark-danger-button"/>
                        <Button text="Clear" onAction="#handleClear" styleClass="dark-secondary-button"/>

                    </HBox>

                </VBox>


                <!-- TABLE -->
                <VBox spacing="10" styleClass="dark-glass-card">

                    <Label text="Expense History" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <TableView fx:id="expenseTable" prefHeight="320" styleClass="dark-table-view">
                        <columns>
                            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="280"/>
                            <TableColumn fx:id="amountColumn" text="Amount (৳)" prefWidth="120"/>
                            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No expenses recorded yet." styleClass="dark-subtitle"/>
                        </placeholder>
                    </TableView>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</StackPane>
