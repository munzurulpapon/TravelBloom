<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../style/style.css, @../style/dark-theme.css, @../style/dark-theme-2.css"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.travelbloom.controller.PackingController">

    <StackPane style="-fx-background-color: #0a1826;">
        <ImageView fx:id="backgroundImage" preserveRatio="false"/>
        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(6,16,26,0.75), rgba(6,16,26,0.92));"/>
    </StackPane>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

        <content>

            <VBox spacing="22">

                <padding>
                    <Insets top="30" right="45" bottom="40" left="45"/>
                </padding>

                <HBox alignment="CENTER_LEFT" styleClass="dark-page-header">
                    <Button text="← Back" onAction="#handleBack" styleClass="dark-secondary-button"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="🎒 Packing List" styleClass="dark-page-header-title"/>
                    <Label text="Never forget an essential again" styleClass="dark-subtitle"/>
                </VBox>

                <VBox spacing="10" styleClass="dark-glass-card">
                    <Label fx:id="progressLabel" text="0 of 0 items packed" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" styleClass="dark-progress-bar"/>
                </VBox>

                <VBox spacing="15" styleClass="dark-glass-card">

                    <Label text="Add / Edit Item" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <GridPane hgap="15" vgap="12">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>

                        <Label text="Item Name:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="itemNameField" promptText="e.g. Sunglasses" styleClass="dark-input"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Category:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="categoryComboBox" promptText="Select category" maxWidth="Infinity" styleClass="dark-combo-box"
                                  GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Quantity:" styleClass="dark-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="quantityField" promptText="1" styleClass="dark-input"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    </GridPane>

                    <HBox spacing="10">

                        <Button text="➕ Add Item" onAction="#handleAddItem" styleClass="dark-primary-button"/>
                        <Button text="✏ Update" onAction="#handleUpdateItem" styleClass="dark-secondary-button"/>
                        <Button text="✔ Toggle Packed" onAction="#handleTogglePacked" styleClass="dark-secondary-button"/>
                        <Button text="🗑 Delete" onAction="#handleDeleteItem" styleClass="dark-danger-button"/>
                        <Button text="Clear" onAction="#handleClear" styleClass="dark-secondary-button"/>

                    </HBox>

                    <Label text="Tip: select a row below, then Update / Toggle Packed / Delete."
                           style="-fx-font-size: 12px; -fx-text-fill: #9fb3c4;"/>

                </VBox>

                <VBox spacing="10" styleClass="dark-glass-card">

                    <Label text="Your Packing List" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <TableView fx:id="packingTable" prefHeight="320" styleClass="dark-table-view">
                        <columns>
                            <TableColumn fx:id="itemColumn" text="Item" prefWidth="220"/>
                            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                            <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="80"/>
                            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="No items yet — add your essentials above." styleClass="dark-subtitle"/>
                        </placeholder>
                    </TableView>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>


    <!-- REMINDER TOAST — shown 1 min, hidden 30s, repeats -->
    <VBox fx:id="suggestionPopup"
          styleClass="reminder-toast"
          maxWidth="300"
          spacing="10"
          StackPane.alignment="TOP_RIGHT">

        <StackPane.margin>
            <Insets top="20" right="20"/>
        </StackPane.margin>

        <HBox alignment="CENTER_LEFT">
            <Label text="✨ Don't forget..." styleClass="reminder-toast-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#handleDismissSuggestions"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 13px; -fx-text-fill: white;"/>
        </HBox>

        <VBox fx:id="suggestionList" spacing="6"/>

        <Button text="➕ Add All" onAction="#handleAddAllSuggestions" styleClass="dark-primary-button" maxWidth="Infinity"/>

    </VBox>

</StackPane>
