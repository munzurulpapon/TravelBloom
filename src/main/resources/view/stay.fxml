<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           stylesheets="@../style/style.css, @../style/dark-theme.css, @../style/dark-theme-2.css"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.travelbloom.controller.StayController">

    <StackPane style="-fx-background-color: #0a1826;">
        <ImageView fx:id="backgroundImage" preserveRatio="false"/>
        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(6,16,26,0.75), rgba(6,16,26,0.92));"/>
    </StackPane>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

        <content>

            <VBox spacing="22">

                <padding>
                    <Insets top="30" right="45" bottom="40" left="45"/>
                </padding>

                <HBox alignment="CENTER_LEFT" styleClass="dark-page-header">
                    <Button text="← Back" onAction="#handleBack" styleClass="dark-secondary-button"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="🏨 Stay / Hotel" styleClass="dark-page-header-title"/>
                    <Label text="Manage your hotel and accommodation details." styleClass="dark-subtitle"/>
                </VBox>


                <!-- HOTEL SEARCH -->
                <VBox spacing="12" styleClass="dark-glass-card">

                    <Label text="🔍 Find Hotels at Your Destination" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Label text="Estimated pricing based on destination and star rating. Connect a live hotel API (see HotelService.java) for real-time rates."
                           styleClass="dark-subtitle" wrapText="true"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Minimum star rating:" styleClass="dark-form-label"/>
                        <ComboBox fx:id="minStarsComboBox" promptText="3" styleClass="dark-combo-box"/>
                        <Button text="🔍 Find Hotels" onAction="#handleFindHotels" styleClass="dark-primary-button"/>
                    </HBox>

                    <VBox fx:id="hotelResultsContainer" spacing="10"/>

                </VBox>


                <!-- INPUT FORM -->
                <VBox spacing="12" styleClass="dark-glass-card">

                    <Label text="Stay Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <GridPane hgap="15" vgap="12">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                            <ColumnConstraints percentWidth="15"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>

                        <Label text="Hotel Name:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="hotelNameField" promptText="Enter hotel name" styleClass="dark-input"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Location:" styleClass="dark-form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <TextField fx:id="locationField" promptText="Hotel location" styleClass="dark-input"
                                   GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Check-in:" styleClass="dark-form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="checkInPicker" styleClass="dark-date-picker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Check-out:" styleClass="dark-form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <DatePicker fx:id="checkOutPicker" styleClass="dark-date-picker" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label text="Cost:" styleClass="dark-form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="costField" promptText="Enter cost" styleClass="dark-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Notes:" styleClass="dark-form-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <TextArea fx:id="notesArea" promptText="Additional notes" prefRowCount="2" styleClass="dark-input"
                                  GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    </GridPane>

                    <HBox spacing="10">
                        <Button text="➕ Add Stay" onAction="#handleAddStay" styleClass="dark-primary-button"/>
                        <Button text="✏ Update" onAction="#handleUpdateStay" styleClass="dark-secondary-button"/>
                        <Button text="🗑 Delete" onAction="#handleDeleteStay" styleClass="dark-danger-button"/>
                        <Button text="Clear" onAction="#handleClear" styleClass="dark-secondary-button"/>
                    </HBox>

                </VBox>


                <!-- TABLE -->
                <VBox spacing="10" styleClass="dark-glass-card">

                    <Label text="Your Stays" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <TableView fx:id="stayTable" prefHeight="320" styleClass="dark-table-view">
                        <columns>
                            <TableColumn fx:id="hotelNameColumn" text="Hotel Name" prefWidth="180"/>
                            <TableColumn fx:id="locationColumn" text="Location" prefWidth="150"/>
                            <TableColumn fx:id="checkInColumn" text="Check-in" prefWidth="120"/>
                            <TableColumn fx:id="checkOutColumn" text="Check-out" prefWidth="120"/>
                            <TableColumn fx:id="costColumn" text="Cost" prefWidth="100"/>
                            <TableColumn fx:id="notesColumn" text="Notes" prefWidth="250"/>
                        </columns>
                        <placeholder>
                            <Label text="No stays added yet." styleClass="dark-subtitle"/>
                        </placeholder>
                    </TableView>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</StackPane>
